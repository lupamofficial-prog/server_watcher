# ===== Required =====
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_ADMIN_IDS=          # your Telegram user id(s), comma separated (ask @userinfobot)
DATABASE_PASSWORD=           # letters and digits only:  openssl rand -hex 16
PROBE_SIGNING_SECRET=        # at least 24 chars:        openssl rand -hex 32
PUBLIC_URL=                  # how probes reach this server, e.g. https://monitor.example.com or http://203.0.113.10:3000

# ===== Optional (safe defaults) =====
# TZ=Europe/Moscow           # timezone used in Telegram messages
# CHECK_INTERVAL=30          # defaults for NEW targets (all editable per target in the bot)
# CHECK_TIMEOUT=5000
# FAILURE_THRESHOLD=3
# RECOVERY_THRESHOLD=2
# REMINDER_MINUTES=0         # >0: repeat "still DOWN" every N minutes (0 = never)
# PROBE_IMAGE=ghcr.io/<org>/haze-monitor-probe:latest   # image used by the probe install script
# COMPOSE_PROFILES=tls       # + DOMAIN=monitor.example.com  -> automatic HTTPS via Caddy
# BACKEND_BIND=127.0.0.1     # with the tls profile, don't expose port 3000 publicly
